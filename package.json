{
  "name": "catalogo-cruzeiro-do-sul",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo Cruzeiro do Sul - portal local com agregador e serviços",
  "main": "server.js",
  "type": "commonjs",
  "bin": {
    "rayx": "rayx/bin/rayx.js"
  },
  "scripts": {
    "agents:cycle": "node scripts/agents-autonomy-cycle.js --once",
    "agents:daemon": "node scripts/agents-autonomy-cycle.js --daemon",
    "agents:run": "node scripts/real-agents-runtime.js",
    "audit:news-images": "node scripts/audit-news-image-focus.js",
    "codex:health": "node scripts/codex-health-check.js",
    "cleanup:audit": "node scripts/cleanup-extreme-audit.js",
    "deploy:storage-check": "node scripts/check-render-storage.js",
    "dns:check": "node scripts/check-dns-readiness.js",
    "editorial:health": "node scripts/editorial-health-check.js",
    "memory:ensure": "node scripts/codex-memory.js ensure",
    "memory:status": "node scripts/codex-memory.js status",
    "ollama:proxy": "node scripts/ollama-secure-proxy.js",
    "ollama:render:tunnel": "node scripts/ollama-render-tunnel.js --deploy",
    "perf:budget": "node scripts/performance-budget-check.js",
    "guard:pubpaid": "node scripts/guard-pubpaid-no-canvas.js",
    "hermes:office:brief": "node scripts/hermes-office-bridge.js brief",
    "hermes:office:dispatch": "node scripts/hermes-office-bridge.js dispatch",
    "hermes:office:render": "node scripts/hermes-office-bridge.js render",
    "hermes:office:run": "node scripts/hermes-office-bridge.js run",
    "hermes:office:status": "node scripts/hermes-office-bridge.js status",
    "hermes:continuity": "node scripts/hermes-continuity-router.js",
    "hermes:continuity:fast": "node scripts/hermes-continuity-router.js --support 4 --include-cloud=false --timeout 60000",
    "hermes:continuity:watch": "node scripts/hermes-continuity-router.js --support 4 --watch --interval 300",
    "hermes:opendesign:brief": "node scripts/hermes-opendesign-bridge.js brief",
    "hermes:opendesign:request": "node scripts/hermes-opendesign-bridge.js request",
    "hermes:opendesign:resources": "node scripts/hermes-opendesign-bridge.js resources",
    "hermes:opendesign:status": "node scripts/hermes-opendesign-bridge.js status",
    "hermes:render:deploy": "node scripts/render-api-bridge.js deploy",
    "hermes:render:deploys": "node scripts/render-api-bridge.js deploys",
    "hermes:render:services": "node scripts/render-api-bridge.js services",
    "hermes:render:status": "node scripts/render-api-bridge.js status",
    "hydrate:source-screenshots": "node scripts/hydrate-source-screenshots.js",
    "review:team": "node scripts/guard-pubpaid-no-canvas.js && node scripts/review-team-audit.js",
    "reels:replace-outro": "python scripts/replace_outro.py",
    "rayx": "node rayx/bin/rayx.js",
    "rayx:boot": "node rayx/core/boot.js",
    "rayx:catalog": "node rayx/core/catalog.js",
    "rayx:chat": "node rayx/core/chat.js",
    "rayx:chrome:profiles": "node rayx/core/chrome-profiles.js",
    "rayx:chrome:bridge": "node rayx/adapters/chrome.js",
    "rayx:build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File rayx/launcher/build-launcher.ps1",
    "rayx:companion": "node rayx/core/companion.js",
    "rayx:dashboard": "node rayx/core/dashboard.js",
    "rayx:desktop": "node rayx/core/desktop.js",
    "rayx:doctor": "node rayx/core/doctor.js --pretty",
    "rayx:doctor:save": "node rayx/core/doctor.js --pretty --out .codex-temp/rayx-doctor/latest.json",
    "rayx:hermes": "node rayx/adapters/hermes.js",
    "rayx:mission": "node rayx/core/mission.js",
    "rayx:open": "node rayx/core/open.js all",
    "rayx:orchestrator": "node rayx/core/orchestrator.js",
    "rayx:cycle": "node rayx/core/orchestrator.js cycle",
    "rayx:test": "node --test rayx/test/*.test.js",
    "rayx:shell": "node rayx/core/shell.js",
    "rayx:status": "node rayx/core/status.js",
    "start": "node server.js",
    "sync:online-local": "node scripts/sync-online-local.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "pdfkit": "^0.17.2",
    "phaser": "^3.90.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^42.3.0"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibiaczs1-star/catalogo-cruzeiro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tibiaczs1-star/catalogo-cruzeiro/issues"
  },
  "homepage": "https://github.com/tibiaczs1-star/catalogo-cruzeiro#readme"
}
