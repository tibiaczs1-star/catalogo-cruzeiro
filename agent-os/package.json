{
  "name": "agent-os",
  "version": "1.0.0",
  "description": "Sistema Operacional de Agentes — Centro de Comando do CZS",
  "main": "runtime/agent-os-server.js",
  "scripts": {
    "agent-os:generate": "node runtime/generate-manifests.js",
    "agent-os:server": "node runtime/agent-os-server.js",
